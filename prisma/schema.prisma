// Banco de produção: Postgres (Neon), conectado via integração Vercel Storage.
// A integração criou as variáveis com o prefixo "Gustavo_" (não "DATABASE_URL"
// puro, por causa de um conflito de nome na hora de conectar) — por isso os
// nomes abaixo são esses, e não os "genéricos" de outros projetos Prisma.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("Gustavo_POSTGRES_PRISMA_URL")
  directUrl = env("Gustavo_POSTGRES_URL_NON_POOLING")
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  pdfUrl     String?
  pdfName    String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
