# Banco Postgres (Neon), criado via Storage na Vercel com o prefixo "Gustavo_".
# Copie os valores reais de Settings → Environment Variables no projeto da Vercel.
Gustavo_POSTGRES_PRISMA_URL="cole-aqui-a-connection-string-com-pooling"
Gustavo_POSTGRES_URL_NON_POOLING="cole-aqui-a-connection-string-direta"

# Login do painel de admin (texto simples, só o servidor lê isso).
ADMIN_EMAIL="gustavo@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"

# Chave secreta para assinar o cookie de sessão — qualquer string longa e aleatória.
SESSION_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# Opcional: só é necessário em produção para permitir upload de foto/PDF.
# Sem isso, o upload local (pasta public/uploads) é usado automaticamente no dev.
# BLOB_READ_WRITE_TOKEN="cole-aqui-o-token-do-Vercel-Blob"
